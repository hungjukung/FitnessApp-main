# ─────────────────────────────────────────────────────────────
# FitTrack Backend — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fittrack_db
DB_USER=fittrack_user
DB_PASSWORD=your_strong_db_password_here
DB_POOL_MAX=10
DB_POOL_MIN=2

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_at_least_64_chars_long_here
JWT_REFRESH_SECRET=your_refresh_token_secret_at_least_64_chars_long_here
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=http://localhost:3001
